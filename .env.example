# Base de données de développement (démarrée par `bash scripts/dev-db.sh up`)
# Conteneur Docker dédié azzel-postgres — Postgres 17, port 54329, volume azzel-postgres-data.
DATABASE_URL=postgres://azzel:azzel@localhost:54329/azzel

# Envoi des codes de connexion et notifications (transport SMTP de nodemailer), format URL :
#   smtp://utilisateur:motdepasse@hote:port
# Local : `bash scripts/dev-mail.sh up` démarre Mailpit (faux SMTP) —
# SMTP localhost:2525, interface http://localhost:8026, toute auth acceptée.
# Sans SMTP_URL, le code à 6 chiffres est journalisé côté serveur (développement).
# SMTP_URL=smtp://azzel:azzel@localhost:2525
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.example.com:587

# Répertoire de stockage des preuves de paiement CCP (story 1.5).
# Chemin relatif au répertoire de travail du serveur ; gitignoré (données coureurs).
# V1 dev/auto-hébergé : disque local derrière l'interface ProofStore —
# remplacé par Supabase storage quand le projet sera provisionné.
STORAGE_DIR=./data/preuves

# Numéro d'assistance affiché par le bouton « Appeler l'équipe » (SM-C1/UX-DR-11).
# Valeur d'exemple par défaut sinon : +213 555 010 200.
# ASSISTANCE_PHONE=+213 555 010 200

# Promotion organisateur (story 1.6) : liste d'emails séparés par des virgules.
# À chaque connexion réussie (code à 6 chiffres), ces emails sont promus
# « organisateur » de façon idempotente — même transaction que le login.
# Les organisateurs voient le lien « Administration » et accèdent à /admin/dossiers.
# Révocation : retirer l'email ici puis, en repli SQL documenté :
#   UPDATE account SET role = 'coureur' WHERE email = '…';
# AZZEL_ADMIN_EMAILS=organisateur@exemple.dz,autre-organisateur@exemple.dz
