{
  "expo": {
    "name": "Azzel",
    "slug": "azzel-runners",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "azzel",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-dev-client",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIOSBackgroundLocationEnabled": true
        }
      ]
    ],
    "android": {
      "package": "dz.azzel.runners"
    },
    "ios": {
      "bundleIdentifier": "dz.azzel.runners"
    }
  }
}
